# gRPC / HTTP listen
GRPC_ADDR=:50051
HTTP_ADDR=:8080

# Path to persisted Syncio connection JSON
CONNECTIONS_STORE_PATH=data/connections.json

# Optional bootstrap JSON array of connections
SYNCIO_CONNECTIONS_JSON=

# govel-shopify HTTP base (shop registry + Admin API proxy)
SHOPIFY_HTTP_BASE=http://127.0.0.1:8081
