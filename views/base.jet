<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{{ title }}</title>
  {{ range css }}
  <link rel="stylesheet" href="/{{ . }}"/>
  {{ end }}
</head>
<body>
{{ yield content }}
{{ range js }}
<script type="module" src="/{{ . }}"></script>
{{ end }}
</body>
</html>
